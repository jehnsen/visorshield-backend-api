DATABASE_URL=postgresql+asyncpg://visorshield:visorshield@localhost/visorshield
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
DEFAULT_PROVIDER=openai
EMBEDDING_MODEL=paraphrase-MiniLM-L6-v2
PGVECTOR_DIMENSIONS=384
EMBEDDING_CACHE_TTL_SECONDS=300

# Webhook alerts (optional — leave blank to disable)
# WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_SECRET=your-hmac-signing-secret
# WEBHOOK_MIN_SEVERITY=all   # all | keyword | embedding

LOG_LEVEL=INFO
ENVIRONMENT=development
